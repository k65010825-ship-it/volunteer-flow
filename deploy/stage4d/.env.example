# Copy to deploy/stage4d/.env and replace every placeholder locally.
# This stack connects to existing MySQL and Redis services; it never manages them.
DB_HOST=replace-with-mysql-host
DB_PORT=replace-with-mysql-port
DB_NAME=volunteer_flow
DB_USERNAME=replace-with-database-user
DB_PASSWORD=replace-with-database-password

JWT_SECRET=replace-with-standard-base64-secret

# The restored demonstration database is already migrated through V9.
# Keep Flyway disabled for that database; do not use this setting as a general default.
SPRING_FLYWAY_ENABLED=false

REDIS_HOST=replace-with-redis-host
REDIS_PORT=replace-with-redis-port
REDIS_PASSWORD=
REDIS_DATABASE=2
REDIS_CONNECT_TIMEOUT=1s
REDIS_COMMAND_TIMEOUT=2s

DYNAMIC_CHECKIN_WINDOW=30s
DYNAMIC_CHECKIN_TTL=45s
DYNAMIC_CHECKIN_TOKEN_BYTES=24

RATE_LIMIT_ENABLED=true
RATE_LIMIT_KEY_SECRET=replace-with-rate-limit-secret
RATE_LIMIT_LOGIN_IP_LIMIT=20
RATE_LIMIT_LOGIN_IP_WINDOW=1m
RATE_LIMIT_LOGIN_USERNAME_LIMIT=5
RATE_LIMIT_LOGIN_USERNAME_WINDOW=5m
RATE_LIMIT_REGISTRATION_LIMIT=3
RATE_LIMIT_REGISTRATION_WINDOW=10s
RATE_LIMIT_PROMOTION_LIMIT=5
RATE_LIMIT_PROMOTION_WINDOW=1m
RATE_LIMIT_STATIC_CHECKIN_LIMIT=5
RATE_LIMIT_STATIC_CHECKIN_WINDOW=1m
RATE_LIMIT_DYNAMIC_CHECKIN_LIMIT=10
RATE_LIMIT_DYNAMIC_CHECKIN_WINDOW=1m
RATE_LIMIT_LOCAL_LOGIN_MAX_ENTRIES=10000
RATE_LIMIT_LOCAL_LOGIN_CLEANUP_INTERVAL=1m

BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_REAL_NAME=
BOOTSTRAP_ADMIN_STUDENT_NUMBER=
BOOTSTRAP_ADMIN_CONTACT=

STAGE4D_APP_PORT=8088
STAGE4D_MIN_AVAILABLE_KB=5242880
STAGE4D_MYSQL_CONTAINER=mysql
STAGE4D_REDIS_CONTAINER=redis-web
STAGE4D_OUTPUT_DIR=replace-with-absolute-run-output-directory
STAGE4D_RUN_ID=replace-with-canonical-lowercase-uuid
STAGE4D_DATASET=normal
STAGE4D_FIXTURE_ACTION=snapshot
