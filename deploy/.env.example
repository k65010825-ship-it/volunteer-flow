# Copy this file to deploy/.env and replace every required placeholder locally.
# DB_HOST can be the VM host address or an existing MySQL container DNS name
# that is reachable from the Compose network. Do not commit deploy/.env.
# Keep single quotes around free-form values so Docker Compose does not
# interpolate dollar signs or other characters in credentials and secrets.
DB_HOST='replace-with-vm-host-or-reachable-mysql-dns'
DB_PORT='replace-with-mysql-host-port'
DB_NAME='volunteer_flow'
DB_USERNAME='replace-with-database-user'
DB_PASSWORD='replace-with-database-password'

# Use standard Base64 encoding of at least 32 random bytes (typically 44 characters for 32 bytes).
JWT_SECRET='replace-with-standard-base64-of-at-least-32-random-bytes'

# This recovered external demo database has already been migrated through V9.
# Keep Flyway disabled here only after verifying its schema and flyway_schema_history.
SPRING_FLYWAY_ENABLED=false

# Reuse the existing VM Redis. Replace host/port locally; do not commit deploy/.env.
REDIS_HOST='replace-with-vm-host-or-reachable-redis-dns'
REDIS_PORT='replace-with-redis-host-port'
REDIS_PASSWORD=''
REDIS_DATABASE=2
REDIS_CONNECT_TIMEOUT=1s
REDIS_COMMAND_TIMEOUT=2s

# Dynamic QR credentials rotate every 30 seconds and expire 45 seconds after the window starts.
DYNAMIC_CHECKIN_WINDOW=30s
DYNAMIC_CHECKIN_TTL=45s
DYNAMIC_CHECKIN_TOKEN_BYTES=24

# Use an independent random secret of at least 32 UTF-8 bytes for HMAC key derivation.
# Changing it starts fresh rate-limit buckets; do not reuse JWT_SECRET.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_KEY_SECRET='replace-with-at-least-32-random-utf8-bytes'
RATE_LIMIT_LOGIN_IP_LIMIT=20
RATE_LIMIT_LOGIN_IP_WINDOW=1m
RATE_LIMIT_LOGIN_USERNAME_LIMIT=5
RATE_LIMIT_LOGIN_USERNAME_WINDOW=5m
RATE_LIMIT_REGISTRATION_LIMIT=3
RATE_LIMIT_REGISTRATION_WINDOW=10s
RATE_LIMIT_PROMOTION_LIMIT=5
RATE_LIMIT_PROMOTION_WINDOW=1m
RATE_LIMIT_STATIC_CHECKIN_LIMIT=5
RATE_LIMIT_STATIC_CHECKIN_WINDOW=1m
RATE_LIMIT_DYNAMIC_CHECKIN_LIMIT=10
RATE_LIMIT_DYNAMIC_CHECKIN_WINDOW=1m
RATE_LIMIT_LOCAL_LOGIN_MAX_ENTRIES=10000
RATE_LIMIT_LOCAL_LOGIN_CLEANUP_INTERVAL=1m

# Bootstrap values are optional. Leave all of them empty to disable bootstrapping.
BOOTSTRAP_ADMIN_USERNAME=''
BOOTSTRAP_ADMIN_PASSWORD=''
BOOTSTRAP_ADMIN_REAL_NAME=''
BOOTSTRAP_ADMIN_STUDENT_NUMBER=''
BOOTSTRAP_ADMIN_CONTACT=''

# Nginx is the only service published on the host.
APP_PORT=8088
