# Copy this file to deploy/.env and replace every required placeholder locally.
# DB_HOST can be the VM host address or an existing MySQL container DNS name
# that is reachable from the Compose network. Do not commit deploy/.env.
# Keep single quotes around free-form values so Docker Compose does not
# interpolate dollar signs or other characters in credentials and secrets.
DB_HOST='replace-with-vm-host-or-reachable-mysql-dns'
DB_PORT='replace-with-mysql-host-port'
DB_NAME='volunteer_flow'
DB_USERNAME='replace-with-database-user'
DB_PASSWORD='replace-with-database-password'

# Use standard Base64 encoding of at least 32 random bytes (typically 44 characters for 32 bytes).
JWT_SECRET='replace-with-standard-base64-of-at-least-32-random-bytes'

# This recovered external demo database has already been migrated through V9.
# Keep Flyway disabled here only after verifying its schema and flyway_schema_history.
SPRING_FLYWAY_ENABLED=false

# Bootstrap values are optional. Leave all of them empty to disable bootstrapping.
BOOTSTRAP_ADMIN_USERNAME=''
BOOTSTRAP_ADMIN_PASSWORD=''
BOOTSTRAP_ADMIN_REAL_NAME=''
BOOTSTRAP_ADMIN_STUDENT_NUMBER=''
BOOTSTRAP_ADMIN_CONTACT=''

# Nginx is the only service published on the host.
APP_PORT=8088
