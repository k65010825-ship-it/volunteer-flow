# Copy to ignored .env. Never source/eval. One unquoted value per line.
# Quotes, backslashes, CR, dollar interpolation and duplicate entries are rejected.
DB_HOST=replace-with-existing-mysql-host
DB_PORT=3307
DB_NAME=volunteer_flow
DB_USERNAME=replace-with-db-user
DB_PASSWORD=replace-with-db-password
JWT_SECRET=replace-with-standard-base64-secret
REDIS_HOST=replace-with-existing-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=2
RATE_LIMIT_KEY_SECRET=replace-with-random-secret
SPRING_FLYWAY_ENABLED=false
STAGE5_MYSQL_CONTAINER=replace-with-existing-mysql-container
STAGE5_REDIS_CONTAINER=redis-web
# Require a quiescent, separately approved maintenance window for full fingerprints.
STAGE5_MAINTENANCE_APPROVED=false
